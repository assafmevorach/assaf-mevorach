b:[["$","title","0",{"children":"Assaf Mevorach | Director of Product Management & Business Strategy, Intel | Thunderbolt, Semiconductors"}],["$","meta","1",{"name":"description","content":"Assaf Mevorach is Director of Business Strategy & Software Solutions at Intel Client Connectivity: 26 years in product management, software engineering leadership, and semiconductors. Creator of Thunderbolt Share (CES 2025 Innovation Award Honoree), named inventor on two US patents, and contributor to the USB4 specification."}],["$","meta","2",{"name":"keywords","content":"Assaf Mevorach,Intel,Product Management,Business Strategy,Director,Thunderbolt,Thunderbolt Share,USB4,Wi-Fi,Semiconductors,Software Engineering Leadership,Connectivity"}],["$","meta","3",{"property":"og:title","content":"Assaf Mevorach | Director of Product Management & Business Strategy, Intel"}],["$","meta","4",{"property":"og:description","content":"26 years at Intel. Creator of Thunderbolt Share (CES 2025 Innovation Award Honoree). Turning deep technology into products people love."}],["$","meta","5",{"property":"og:image","content":"https://assaf-mevorach.vercel.app/photos/headshot.jpg"}],["$","meta","6",{"property":"og:type","content":"website"}],["$","meta","7",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","8",{"name":"twitter:title","content":"Assaf Mevorach | Director of Product Management & Business Strategy, Intel"}],["$","meta","9",{"name":"twitter:description","content":"26 years at Intel. Creator of Thunderbolt Share (CES 2025 Innovation Award Honoree). Turning deep technology into products people love."}],["$","meta","10",{"name":"twitter:image","content":"https://assaf-mevorach.vercel.app/photos/headshot.jpg"}],["$","link","11",{"rel":"icon","href":"/favicon.ico?favicon.2vob68tjqpejf.ico","sizes":"256x256","type":"image/x-icon"}],["$","$Ld","12",{}]]
